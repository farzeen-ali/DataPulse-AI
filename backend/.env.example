# ─────────────────────────────────────────────────────────────────────────────
# DataPulse AI — backend environment. Copy to `.env` and fill in real values.
# `.env` is git-ignored. NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# Google AI Studio key for Gemini (server-side only, never sent to the browser).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# RUNTIME connection — used by the API to run AI-generated SQL.
# MUST use the least-privilege role created by `npm run db:setup-role`,
# never `postgres`, the service role, or the migration credentials.
# Supabase pooler (transaction mode) user format: <role>.<project-ref>
SUPABASE_DATABASE_URL=postgresql://datapulse_analytics.<project-ref>:<analytics-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# MIGRATION / OWNER connection — used ONLY by Prisma migrate, the seed and
# the role setup script. Direct connection (port 5432), `postgres` user.
SUPABASE_DIRECT_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# Password assigned to the analytics role by `npm run db:setup-role` (16+ chars).
ANALYTICS_DB_PASSWORD=

# TLS: require (Supabase default) | verify (+ DATABASE_CA_CERT as PEM text) | disable (local only)
DATABASE_SSL=require
# DATABASE_CA_CERT=

# Comma-separated browser origins allowed by CORS.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Safety limits
QUERY_TIMEOUT_MS=5000
QUERY_RATE_LIMIT_PER_MINUTE=10

# Set when running behind a reverse proxy (e.g. "1" or "loopback") so rate
# limiting sees real client IPs.
# TRUST_PROXY=
